---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { filterGamesByTitle, getAllGames } from '../lib/games';

export const prerender = true;

const searchTerm = (Astro.url.searchParams.get('q') ?? '').trim();
const allGames = await getAllGames(getDatabase());
const games = filterGamesByTitle(allGames, searchTerm);
const emptyMessage = searchTerm
  ? `No games match "${searchTerm}".`
  : 'No games available at the moment.';
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8">
      <form method="get" action="/" role="search" class="max-w-xl" data-testid="game-search-form">
        <label for="game-search" class="mb-2 block text-sm font-medium text-slate-200">Search games by title</label>
        <div class="flex gap-3">
          <input
            id="game-search"
            name="q"
            type="search"
            value={searchTerm}
            placeholder="Search games by title"
            autocomplete="off"
            class="w-full rounded-xl border border-slate-600 bg-slate-900/70 px-4 py-3 text-slate-100 placeholder:text-slate-400 shadow-sm outline-none transition duration-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/40"
            data-testid="game-search"
          />
          <button
            type="submit"
            class="rounded-xl bg-blue-600 px-4 py-3 font-medium text-white transition hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="game-search-submit"
          >
            Search
          </button>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <div class={games.length === 0 ? '' : 'hidden'} data-testid="empty-state-wrapper">
        <EmptyState text={emptyMessage} />
      </div>

      <div class={games.length === 0 ? 'hidden' : ''} data-testid="games-grid">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </div>
  </div>

  <script>
    const searchInput = document.querySelector('[data-testid="game-search"]');
    const searchForm = document.querySelector('[data-testid="game-search-form"]');
    const gameCards = Array.from(document.querySelectorAll('[data-testid="game-card"]'));
    const gamesGrid = document.querySelector('[data-testid="games-grid"]');
    const emptyStateWrapper = document.querySelector('[data-testid="empty-state-wrapper"]');
    const emptyState = document.querySelector('[data-testid="empty-state"]');
    const emptyStateText = document.querySelector('[data-testid="empty-state-text"]');

    const setVisibility = (element, shouldHide) => {
      if (!element) {
        return;
      }

      element.hidden = shouldHide;
      element.classList.toggle('hidden', shouldHide);
    };

    const updateGameList = () => {
      if (!searchInput) {
        return;
      }

      const term = searchInput.value.trim().toLowerCase();
      let visibleCount = 0;

      for (const card of gameCards) {
        const title = (card.getAttribute('data-game-title') ?? '').toLowerCase();
        const matches = !term || title.includes(term);
        card.hidden = !matches;

        if (matches) {
          visibleCount += 1;
        }
      }

      if (gamesGrid) {
        setVisibility(gamesGrid, visibleCount === 0);
      }

      if (emptyStateWrapper) {
        setVisibility(emptyStateWrapper, visibleCount !== 0);
      }

      if (emptyState) {
        setVisibility(emptyState, visibleCount !== 0);
      }

      if (emptyStateText) {
        const nextMessage = term
          ? `No games match "${searchInput.value.trim()}".`
          : 'No games available at the moment.';
        emptyStateText.textContent = nextMessage;
      }
    };

    searchInput?.addEventListener('input', updateGameList);
    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      updateGameList();

      const term = (searchInput?.value ?? '').trim();
      const url = new URL(window.location.href);

      if (term) {
        url.searchParams.set('q', term);
      } else {
        url.searchParams.delete('q');
      }

      window.history.replaceState({}, '', url);
    });
  </script>
</Layout>
